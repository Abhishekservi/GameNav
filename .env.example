# Defaults work without an API key. Restart Metro after changing EXPO_PUBLIC_*.
# Alternative providers must use the OpenMapTiles schema and support MapLibre Native.
EXPO_PUBLIC_MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
EXPO_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
EXPO_PUBLIC_MAP_ATTRIBUTION=<a href="https://openfreemap.org">OpenFreeMap</a> © <a href="https://openmaptiles.org">OpenMapTiles</a> © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Photon-compatible HTTPS endpoint. Public host is for modest development use.
# Use a supported hosted/self-hosted instance before wider deployment.
EXPO_PUBLIC_SEARCH_URL=https://photon.komoot.io/api/
